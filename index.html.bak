<title>Nourish</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap">
<style>
  :root{
    --bg:#F1F4F0; --surface:#FFFFFF; --surface-2:#F7F9F6; --line:#E3E8E0;
    --ink:#1C2621; --ink-2:#566159; --ink-3:#8A948B;
    --brand:#1F9D6B; --brand-soft:#DCF1E7; --brand-ink:#12684a;
    --water:#2E9BE4; --water-soft:#DBEEFB;
    --p:#E4572E; --c:#E8A13A; --f:#7C5CFF; --fib:#3FA34D;
    --amber:#E8A13A; --danger:#DC5B4B;
    --shadow:0 1px 2px rgba(28,38,33,.06),0 8px 24px rgba(28,38,33,.06);
    --shadow-lg:0 12px 40px rgba(28,38,33,.16);
    --r:18px; --r-sm:12px;
    --safe-b:env(safe-area-inset-bottom,0px);
    --nav-h:66px;
  }
  @media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
    --bg:#0F1512; --surface:#18201C; --surface-2:#131A16; --line:#28322C;
    --ink:#EAF0EB; --ink-2:#A5B0A8; --ink-3:#6E7972;
    --brand:#39C489; --brand-soft:#173a2b; --brand-ink:#8AE7BF;
    --water:#54B0F0; --water-soft:#12303f;
    --brand-soft:#173a2b;
    --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.35);
    --shadow-lg:0 12px 40px rgba(0,0,0,.5);
  }}
  :root[data-theme="dark"]{
    --bg:#0F1512; --surface:#18201C; --surface-2:#131A16; --line:#28322C;
    --ink:#EAF0EB; --ink-2:#A5B0A8; --ink-3:#6E7972;
    --brand:#39C489; --brand-soft:#173a2b; --brand-ink:#8AE7BF;
    --water:#54B0F0; --water-soft:#12303f;
    --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.35);
    --shadow-lg:0 12px 40px rgba(0,0,0,.5);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{
    background:var(--bg); color:var(--ink);
    font-family:Figtree,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    -webkit-font-smoothing:antialiased; line-height:1.45;
    overscroll-behavior-y:none;
  }
  .num{font-family:"Bricolage Grotesque",Figtree,sans-serif;font-weight:800;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
  button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
  input,select{font-family:inherit;font-size:16px;color:inherit}
  ::selection{background:var(--brand-soft)}

  /* ---- app shell (phone frame on desktop) ---- */
  .app{
    max-width:480px; margin:0 auto; min-height:100dvh; position:relative;
    background:var(--bg); display:flex; flex-direction:column;
  }
  @media(min-width:520px){
    body{background:radial-gradient(120% 120% at 50% 0%,var(--surface-2),var(--bg))}
    .app{min-height:auto;height:min(880px,96dvh);margin:2dvh auto;border-radius:34px;
      box-shadow:var(--shadow-lg);overflow:hidden;border:1px solid var(--line)}
  }
  .scroll{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:0 16px 96px}
  .scroll::-webkit-scrollbar{width:0}

  /* ---- header ---- */
  .top{padding:calc(env(safe-area-inset-top,0px) + 14px) 16px 8px;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
  .top .date{font-size:13px;color:var(--ink-3);font-weight:600;text-transform:uppercase;letter-spacing:.06em}
  .top h1{font-family:"Bricolage Grotesque";font-weight:800;font-size:26px;letter-spacing:-.02em;line-height:1.1;text-wrap:balance;margin-top:2px}
  .iconbtn{width:40px;height:40px;border-radius:50%;background:var(--surface);box-shadow:var(--shadow);display:grid;place-items:center;flex:none;font-size:18px;transition:transform .12s}
  .iconbtn:active{transform:scale(.92)}
  .motiv{background:var(--brand-soft);color:var(--brand-ink);border-radius:var(--r-sm);padding:11px 14px;font-size:13.5px;font-weight:600;margin:6px 16px 10px;display:flex;gap:8px;align-items:center}
  .motiv b{font-weight:800}

  /* ---- cards ---- */
  .card{background:var(--surface);border-radius:var(--r);box-shadow:var(--shadow);padding:18px;margin-bottom:14px;border:1px solid transparent}
  @media(prefers-color-scheme:dark){:root:not([data-theme="light"]) .card{border-color:var(--line)}}
  :root[data-theme="dark"] .card{border-color:var(--line)}
  .card h2{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-3);font-weight:700;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center}
  .card h2 button{color:var(--brand);font-size:12px;font-weight:700;text-transform:none;letter-spacing:0}

  /* ---- calorie ring hero ---- */
  .cal-hero{display:flex;align-items:center;gap:18px}
  .ring-wrap{position:relative;width:132px;height:132px;flex:none}
  .ring-wrap .center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
  .ring-wrap .big{font-size:34px;line-height:1}
  .ring-wrap .lbl{font-size:11px;color:var(--ink-3);font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-top:3px}
  .cal-side{flex:1;display:flex;flex-direction:column;gap:12px}
  .cal-stat{display:flex;justify-content:space-between;align-items:baseline;font-size:13px;color:var(--ink-2);font-weight:600}
  .cal-stat .num{font-size:17px;color:var(--ink)}
  .cal-stat .over{color:var(--danger)}

  /* ---- macro bars ---- */
  .macros{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:16px}
  .macro{text-align:center}
  .macro .mring{position:relative;width:100%;aspect-ratio:1;max-width:64px;margin:0 auto 6px}
  .macro .mnum{font-size:14px}
  .macro .mlbl{font-size:11px;color:var(--ink-3);font-weight:700}
  .macro .mval{font-size:11px;color:var(--ink-2);font-weight:600}

  /* ---- water ---- */
  .water-row{display:flex;align-items:center;gap:16px}
  .glass{position:relative;width:56px;height:74px;flex:none;border:3px solid var(--water);border-top:none;border-radius:6px 6px 14px 14px;overflow:hidden;background:var(--water-soft)}
  .glass .fill{position:absolute;left:0;right:0;bottom:0;background:var(--water);transition:height .45s cubic-bezier(.4,1.3,.5,1)}
  .glass .fill::before{content:"";position:absolute;top:-6px;left:0;right:0;height:8px;background:var(--water);opacity:.5;border-radius:50%}
  .water-info{flex:1}
  .water-info .num{font-size:22px}
  .water-info .sub{font-size:12.5px;color:var(--ink-3);font-weight:600}
  .water-btns{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
  .chip{background:var(--surface-2);border:1px solid var(--line);border-radius:999px;padding:8px 13px;font-size:13px;font-weight:700;display:flex;align-items:center;gap:5px;transition:transform .1s,background .15s}
  .chip:active{transform:scale(.94)}
  .chip.water{color:var(--water)}
  .chip.minus{color:var(--ink-3);padding:8px 12px}

  /* ---- meals ---- */
  .meal-group{margin-bottom:6px}
  .meal-head{display:flex;align-items:center;justify-content:space-between;padding:6px 2px}
  .meal-head .t{font-weight:700;font-size:14px;display:flex;align-items:center;gap:7px}
  .meal-head .t .em{font-size:16px}
  .meal-head .cal{font-size:12.5px;color:var(--ink-3);font-weight:700}
  .meal-add{color:var(--brand);font-weight:700;font-size:13px;padding:6px 4px}
  .food-item{display:flex;align-items:center;gap:10px;padding:9px 2px;border-top:1px solid var(--line)}
  .food-item:first-child{border-top:none}
  .food-item .fi-name{flex:1;font-size:14px;font-weight:600}
  .food-item .fi-name small{display:block;color:var(--ink-3);font-size:12px;font-weight:500}
  .food-item .fi-cal{font-size:13.5px;font-weight:700;font-variant-numeric:tabular-nums}
  .food-item .del{color:var(--ink-3);font-size:15px;padding:4px 6px;opacity:.7}
  .empty{color:var(--ink-3);font-size:13px;text-align:center;padding:18px;font-weight:500}

  /* ---- habits ---- */
  .habit{display:flex;align-items:center;gap:14px;padding:14px 0;border-top:1px solid var(--line)}
  .habit:first-child{border-top:none}
  .habit .h-em{width:44px;height:44px;border-radius:13px;background:var(--surface-2);display:grid;place-items:center;font-size:20px;flex:none}
  .habit .h-body{flex:1;min-width:0}
  .habit .h-name{font-weight:700;font-size:15px}
  .habit .h-streak{font-size:12px;color:var(--ink-3);font-weight:600;display:flex;align-items:center;gap:4px}
  .habit .h-streak.live{color:var(--amber)}
  .check{width:34px;height:34px;border-radius:50%;border:2px solid var(--line);flex:none;display:grid;place-items:center;font-size:16px;color:#fff;transition:transform .15s,background .15s,border-color .15s}
  .check.on{background:var(--brand);border-color:var(--brand)}
  .check:active{transform:scale(.86)}
  .counter{display:flex;align-items:center;gap:10px}
  .counter button{width:32px;height:32px;border-radius:50%;background:var(--surface-2);border:1px solid var(--line);font-size:18px;font-weight:700;display:grid;place-items:center;line-height:1}
  .counter .cval{min-width:44px;text-align:center;font-size:14px;font-weight:700}
  .counter .cval small{color:var(--ink-3);font-weight:600}

  /* ---- foods tab ---- */
  .search{display:flex;align-items:center;gap:10px;background:var(--surface);border-radius:14px;padding:12px 15px;box-shadow:var(--shadow);margin:4px 0 12px}
  .search input{border:none;background:none;flex:1;outline:none}
  .search .ic{color:var(--ink-3)}
  .cats{display:flex;gap:8px;overflow-x:auto;padding:2px 0 12px;scrollbar-width:none}
  .cats::-webkit-scrollbar{height:0}
  .cat{white-space:nowrap;padding:7px 14px;border-radius:999px;background:var(--surface);border:1px solid var(--line);font-size:13px;font-weight:600;flex:none}
  .cat.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
  .flist .food-item{border-top-color:var(--line);cursor:pointer}
  .flist .food-item .add-ic{color:var(--brand);font-size:22px;font-weight:700;line-height:1}
  .flist .cat-h{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);padding:14px 2px 4px}

  /* ---- goals / you ---- */
  .field{margin-bottom:14px}
  .field label{display:block;font-size:12px;font-weight:700;color:var(--ink-2);margin-bottom:6px;text-transform:uppercase;letter-spacing:.04em}
  .field .inrow{display:flex;align-items:center;gap:8px;background:var(--surface-2);border:1px solid var(--line);border-radius:12px;padding:0 14px}
  .field .inrow input{flex:1;border:none;background:none;outline:none;padding:13px 0}
  .field .inrow .unit{color:var(--ink-3);font-size:13px;font-weight:600}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .weekbars{display:flex;align-items:flex-end;gap:8px;height:100px;padding-top:8px}
  .wk{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end}
  .wk .bar{width:100%;max-width:26px;border-radius:6px 6px 3px 3px;background:var(--brand-soft);position:relative;min-height:4px;transition:height .4s}
  .wk .bar .cap{position:absolute;inset:0;top:auto;height:var(--h);bottom:0;background:var(--brand);border-radius:6px 6px 3px 3px}
  .wk .d{font-size:11px;color:var(--ink-3);font-weight:700}
  .wk.today .d{color:var(--brand)}

  /* ---- bottom nav ---- */
  .nav{position:sticky;bottom:0;left:0;right:0;height:calc(var(--nav-h) + var(--safe-b));padding-bottom:var(--safe-b);
    background:color-mix(in srgb,var(--surface) 88%,transparent);backdrop-filter:blur(16px) saturate(1.4);
    -webkit-backdrop-filter:blur(16px) saturate(1.4);border-top:1px solid var(--line);
    display:flex;align-items:stretch;z-index:30}
  .nav button{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;color:var(--ink-3);font-size:10.5px;font-weight:700;letter-spacing:.02em}
  .nav button svg{width:23px;height:23px;stroke:currentColor;stroke-width:2;fill:none}
  .nav button.on{color:var(--brand)}
  .nav button.on svg{fill:var(--brand-soft)}

  /* ---- FAB ---- */
  .fab{position:absolute;bottom:calc(var(--nav-h) + var(--safe-b) + 16px);right:20px;width:58px;height:58px;border-radius:50%;
    background:var(--brand);color:#fff;box-shadow:0 8px 24px rgba(31,157,107,.44);display:grid;place-items:center;font-size:30px;z-index:35;transition:transform .14s}
  .fab:active{transform:scale(.9)}

  /* ---- sheet / modal ---- */
  .scrim{position:fixed;inset:0;background:rgba(15,21,18,.5);z-index:40;opacity:0;pointer-events:none;transition:opacity .25s}
  .scrim.on{opacity:1;pointer-events:auto}
  .sheet{position:fixed;left:50%;bottom:0;transform:translate(-50%,100%);width:100%;max-width:480px;
    background:var(--surface);border-radius:24px 24px 0 0;z-index:41;transition:transform .32s cubic-bezier(.32,.72,0,1);
    max-height:88dvh;display:flex;flex-direction:column;box-shadow:var(--shadow-lg)}
  .sheet.on{transform:translate(-50%,0)}
  .sheet .grab{width:38px;height:4px;background:var(--line);border-radius:2px;margin:10px auto 4px;flex:none}
  .sheet .sh-head{padding:8px 20px 12px;display:flex;align-items:center;justify-content:space-between;flex:none}
  .sheet .sh-head h3{font-family:"Bricolage Grotesque";font-weight:800;font-size:20px}
  .sheet .sh-head .x{font-size:22px;color:var(--ink-3);width:34px;height:34px;display:grid;place-items:center}
  .sheet .sh-body{overflow-y:auto;padding:0 20px 24px;flex:1}
  .sheet .sh-body.pad-b{padding-bottom:calc(24px + var(--safe-b))}

  .btn{display:block;width:100%;padding:15px;border-radius:14px;background:var(--brand);color:#fff;font-weight:700;font-size:15.5px;text-align:center;transition:transform .1s,opacity .15s}
  .btn:active{transform:scale(.98)}
  .btn.ghost{background:var(--surface-2);color:var(--ink);border:1px solid var(--line)}
  .btn.danger{background:none;color:var(--danger);box-shadow:none}

  /* qty picker */
  .qty-food{display:flex;align-items:center;gap:12px;padding:12px 0 16px}
  .qty-food .qf-em{font-size:30px}
  .qty-food .qf-n{font-weight:700;font-size:17px}
  .qty-food .qf-s{font-size:13px;color:var(--ink-3);font-weight:600}
  .seg{display:flex;gap:8px;margin:6px 0 16px;flex-wrap:wrap}
  .seg button{flex:1;min-width:60px;padding:11px;border-radius:12px;background:var(--surface-2);border:1px solid var(--line);font-weight:700;font-size:14px}
  .seg button.on{background:var(--brand);color:#fff;border-color:var(--brand)}
  .meal-pick{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:16px}
  .meal-pick button{padding:12px 4px;border-radius:12px;background:var(--surface-2);border:1px solid var(--line);font-weight:700;font-size:12.5px;display:flex;flex-direction:column;gap:4px;align-items:center}
  .meal-pick button .em{font-size:18px}
  .meal-pick button.on{background:var(--brand-soft);border-color:var(--brand);color:var(--brand-ink)}
  .nutri-prev{display:flex;justify-content:space-around;background:var(--surface-2);border-radius:12px;padding:12px;margin-bottom:16px}
  .nutri-prev div{text-align:center}
  .nutri-prev .v{font-size:16px}
  .nutri-prev .k{font-size:11px;color:var(--ink-3);font-weight:700;text-transform:uppercase}

  /* toast */
  .toast{position:fixed;left:50%;bottom:calc(var(--nav-h) + 30px);transform:translate(-50%,20px);background:var(--ink);color:var(--bg);
    padding:12px 20px;border-radius:999px;font-weight:700;font-size:14px;z-index:60;opacity:0;pointer-events:none;transition:.28s;box-shadow:var(--shadow-lg);white-space:nowrap}
  .toast.on{opacity:1;transform:translate(-50%,0)}

  /* celebrate */
  @keyframes pop{0%{transform:scale(0) rotate(0)}60%{transform:scale(1.15) rotate(8deg)}100%{transform:scale(1) rotate(0)}}
  .burst{position:fixed;z-index:70;font-size:26px;pointer-events:none;animation:conf 1s ease-out forwards}
  @keyframes conf{0%{opacity:1;transform:translate(0,0) scale(.4)}100%{opacity:0;transform:translate(var(--dx),var(--dy)) scale(1.1)}}

  @media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
  .addfood-link{text-align:center;padding:16px;color:var(--brand);font-weight:700;font-size:14px}
</style>

<div class="app" id="app">
  <div id="view" class="scroll"></div>
  <button class="fab" id="fab" aria-label="Log a meal">+</button>
  <nav class="nav" id="nav">
    <button data-tab="today" class="on"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Today</button>
    <button data-tab="habits"><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>Habits</button>
    <button data-tab="foods"><svg viewBox="0 0 24 24"><path d="M4 3v7a3 3 0 003 3v8M7 3v6M18 3c-1.5 0-2 4-2 6s.5 3 2 3v9"/></svg>Foods</button>
    <button data-tab="you"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>You</button>
  </nav>
</div>

<div class="scrim" id="scrim"></div>
<div class="sheet" id="sheet"><div class="grab"></div><div class="sh-head"><h3 id="sh-title"></h3><button class="x" id="sh-x">✕</button></div><div class="sh-body pad-b" id="sh-body"></div></div>
<div class="toast" id="toast"></div>

<script>
"use strict";
/* ============================ DATA ============================ */
// Nutrients are per typical serving. cal=kcal, p/c/f/fib in grams.
const FOODS = [
 // Dals & Legumes
 {n:"Dal Tadka",e:"🍲",s:"1 bowl (200g)",cal:180,p:9,c:24,f:6,fib:6,cat:"Dal & Legumes"},
 {n:"Dal Makhani",e:"🍲",s:"1 bowl (200g)",cal:290,p:11,c:26,f:15,fib:8,cat:"Dal & Legumes"},
 {n:"Rajma (Kidney Bean Curry)",e:"🫘",s:"1 bowl (200g)",cal:245,p:12,c:34,f:6,fib:11,cat:"Dal & Legumes"},
 {n:"Chana Masala",e:"🫘",s:"1 bowl (200g)",cal:270,p:13,c:38,f:7,fib:12,cat:"Dal & Legumes"},
 {n:"Chole",e:"🫘",s:"1 bowl (200g)",cal:290,p:13,c:40,f:9,fib:12,cat:"Dal & Legumes"},
 {n:"Sambar",e:"🍲",s:"1 bowl (200g)",cal:150,p:7,c:22,f:4,fib:6,cat:"Dal & Legumes"},
 {n:"Moong Dal (yellow)",e:"🍲",s:"1 bowl (200g)",cal:160,p:11,c:24,f:3,fib:7,cat:"Dal & Legumes"},
 {n:"Kadhi Pakora",e:"🍲",s:"1 bowl (200g)",cal:230,p:8,c:20,f:13,fib:2,cat:"Dal & Legumes"},
 // Sabzis / Veg curries
 {n:"Palak Paneer",e:"🥬",s:"1 bowl (200g)",cal:280,p:14,c:12,f:20,fib:4,cat:"Vegetables"},
 {n:"Paneer Butter Masala",e:"🧀",s:"1 bowl (200g)",cal:350,p:14,c:16,f:26,fib:3,cat:"Vegetables"},
 {n:"Aloo Gobi",e:"🥔",s:"1 bowl (200g)",cal:180,p:5,c:24,f:8,fib:6,cat:"Vegetables"},
 {n:"Bhindi Masala",e:"🌿",s:"1 bowl (150g)",cal:160,p:4,c:14,f:10,fib:5,cat:"Vegetables"},
 {n:"Baingan Bharta",e:"🍆",s:"1 bowl (200g)",cal:170,p:4,c:16,f:11,fib:6,cat:"Vegetables"},
 {n:"Mixed Veg Curry",e:"🥕",s:"1 bowl (200g)",cal:190,p:5,c:20,f:10,fib:6,cat:"Vegetables"},
 {n:"Aloo Matar",e:"🥔",s:"1 bowl (200g)",cal:200,p:6,c:28,f:7,fib:6,cat:"Vegetables"},
 {n:"Bhindi Fry",e:"🌿",s:"1 bowl (150g)",cal:170,p:4,c:12,f:12,fib:5,cat:"Vegetables"},
 {n:"Malai Kofta",e:"🧆",s:"2 kofta + gravy",cal:400,p:11,c:26,f:28,fib:3,cat:"Vegetables"},
 {n:"Paneer Bhurji",e:"🧀",s:"1 bowl (150g)",cal:290,p:16,c:8,f:22,fib:2,cat:"Vegetables"},
 {n:"Matar Paneer",e:"🧀",s:"1 bowl (200g)",cal:300,p:14,c:18,f:19,fib:5,cat:"Vegetables"},
 {n:"Jeera Aloo",e:"🥔",s:"1 bowl (150g)",cal:190,p:3,c:26,f:9,fib:4,cat:"Vegetables"},
 // Breads
 {n:"Roti / Chapati",e:"🫓",s:"1 piece",cal:110,p:3,c:20,f:2,fib:3,cat:"Breads"},
 {n:"Tandoori Roti",e:"🫓",s:"1 piece",cal:130,p:4,c:24,f:2,fib:3,cat:"Breads"},
