const MEALS = [{k:"breakfast",l:"Breakfast",e:"🌅"},{k:"lunch",l:"Lunch",e:"☀️"},{k:"snack",l:"Snacks",e:"🫖"},{k:"dinner",l:"Dinner",e:"🌙"}];

const QUOTES = [
 "Small steps, every day. 🌱",
 "You don't have to be perfect — just consistent.",
 "A healthy outside starts from the inside.",
 "Discipline is choosing what you want most over what you want now.",
 "Progress, not perfection.",
 "Your body hears everything your mind says. Stay positive. 💚",
 "One meal at a time. One day at a time.",
 "The secret of getting ahead is getting started.",
 "Take care of your body. It's the only place you have to live.",
 "Fall in love with taking care of yourself.",
];

const DEFAULT_HABITS = [
 {id:"h_workout",name:"Workout",e:"🏋️",type:"check"},
 {id:"h_sleep",name:"Sleep 7+ hrs",e:"😴",type:"check"},
 {id:"h_steps",name:"10k Steps",e:"👟",type:"check"},
 {id:"h_meditate",name:"Meditate",e:"🧘",type:"check"},
 {id:"h_fruit",name:"Eat a fruit",e:"🍎",type:"count",target:2},
];

/* ============================ STATE ============================ */
const KEY="nourish.v1";
const todayStr=()=>new Date().toLocaleDateString("en-CA"); // YYYY-MM-DD local
function loadState(){
  let s;
  try{ s=JSON.parse(localStorage.getItem(KEY)); }catch(e){ s=null; }
  if(!s||typeof s!=="object") s={};
  s.profile=Object.assign({calGoal:2000,p:120,c:220,f:60,fib:30,waterGoal:2500,glass:250},s.profile||{});
  s.days=s.days||{};
  s.habits=s.habits||DEFAULT_HABITS.map(h=>Object.assign({},h));
  s.customFoods=s.customFoods||[];
  return s;
}
let S=loadState();
function save(){ try{ localStorage.setItem(KEY,JSON.stringify(S)); }catch(e){} }
function day(d){ d=d||todayStr(); if(!S.days[d]) S.days[d]={meals:[],water:0,habits:{}}; return S.days[d]; }

/* ============================ HELPERS ============================ */
const $=(s,r=document)=>r.querySelector(s);
const clamp=(n,a,b)=>Math.max(a,Math.min(b,n));
const round=n=>Math.round(n);
function sumMeals(meals){
  return meals.reduce((t,m)=>{t.cal+=m.cal;t.p+=m.p;t.c+=m.c;t.f+=m.f;t.fib+=m.fib;return t;},{cal:0,p:0,c:0,f:0,fib:0});
}
function allFoods(){ return S.customFoods.concat(FOODS); }
function ring(pct,color,size,stroke){
  const r=(size-stroke)/2, C=2*Math.PI*r, off=C*(1-clamp(pct,0,1));
  return `<svg viewBox="0 0 ${size} ${size}" width="${size}" height="${size}" style="transform:rotate(-90deg)">
    <circle cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="var(--line)" stroke-width="${stroke}"/>
    <circle cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="${color}" stroke-width="${stroke}"
      stroke-linecap="round" stroke-dasharray="${C}" stroke-dashoffset="${off}" style="transition:stroke-dashoffset .6s ease"/>
  </svg>`;
}
function streak(habitId){
  // consecutive days ending today (or yesterday if today not yet done) where habit completed
  const h=S.habits.find(x=>x.id===habitId); if(!h) return 0;
  let count=0; const d=new Date();
  // allow today to be incomplete without breaking streak until day ends
  for(let i=0;i<400;i++){
    const ds=new Date(d.getTime()-i*86400000).toLocaleDateString("en-CA");
    const rec=S.days[ds]; const done=isHabitDone(h,rec);
    if(done){ count++; }
    else if(i===0){ continue; } // today not done yet — keep looking back
    else break;
  }
  return count;
}
function isHabitDone(h,rec){
  if(!rec||!rec.habits) return false;
  const v=rec.habits[h.id];
  if(h.type==="count") return (v||0)>=(h.target||1);
  return !!v;
}

/* ============================ RENDER ============================ */
let TAB="today";
function render(){
  const v=$("#view");
  if(TAB==="today") v.innerHTML=viewToday();
  else if(TAB==="habits") v.innerHTML=viewHabits();
  else if(TAB==="foods") v.innerHTML=viewFoods();
  else if(TAB==="you") v.innerHTML=viewYou();
  bind();
  document.querySelectorAll("#nav button").forEach(b=>b.classList.toggle("on",b.dataset.tab===TAB));
  $("#fab").style.display = TAB==="today" ? "grid" : "none";
}

function header(title){
  const d=new Date();
  const ds=d.toLocaleDateString("en-US",{weekday:"long",month:"short",day:"numeric"});
  return `<div class="top"><div><div class="date">${ds}</div><h1>${title}</h1></div>
    <button class="iconbtn" data-act="theme" aria-label="Toggle theme">◐</button></div>`;
}

/* ---------- TODAY ---------- */
function viewToday(){
  const t=day(); const tot=sumMeals(t.meals); const pr=S.profile;
  const left=pr.calGoal-tot.cal;
  const q=QUOTES[new Date().getDate()%QUOTES.length];
  const macro=(lbl,key,val,goal,color)=>`
    <div class="macro"><div class="mring">${ring(goal?val/goal:0,color,58,7)}
      <div class="center" style="position:absolute;inset:0;display:grid;place-items:center">
        <div class="num mnum" style="color:${color}">${round(val)}</div></div></div>
      <div class="mlbl">${lbl}</div><div class="mval">/ ${goal}g</div></div>`;
  return header("Today")+
  `<div class="motiv"><b>💚</b><span>${q}</span></div>
  <div class="scroll-inner" style="padding:0 0 0">
    <div class="card">
      <div class="cal-hero">
        <div class="ring-wrap">${ring(pr.calGoal?tot.cal/pr.calGoal:0,tot.cal>pr.calGoal?"var(--danger)":"var(--brand)",132,13)}
          <div class="center"><div class="num big">${round(Math.abs(left))}</div>
          <div class="lbl">${left>=0?"kcal left":"kcal over"}</div></div>
        </div>
        <div class="cal-side">
          <div class="cal-stat"><span>Goal</span><span class="num">${pr.calGoal}</span></div>
          <div class="cal-stat"><span>Eaten</span><span class="num">${round(tot.cal)}</span></div>
          <div class="cal-stat"><span>Remaining</span><span class="num ${left<0?'over':''}">${round(left)}</span></div>
        </div>
      </div>
      <div class="macros">
        ${macro("Protein","p",tot.p,pr.p,"var(--p)")}
        ${macro("Carbs","c",tot.c,pr.c,"var(--c)")}
        ${macro("Fat","f",tot.f,pr.f,"var(--f)")}
        ${macro("Fiber","fib",tot.fib,pr.fib,"var(--fib)")}
      </div>
    </div>

    <div class="card">
      <h2>Water <button data-act="water-goal">Goal · ${(pr.waterGoal/1000).toFixed(2)}L</button></h2>
      <div class="water-row">
        <div class="glass"><div class="fill" style="height:${clamp(t.water/pr.waterGoal,0,1)*100}%"></div></div>
        <div class="water-info">
          <div class="num">${(t.water/1000).toFixed(2)}<span style="font-size:14px;color:var(--ink-3)">L</span></div>
          <div class="sub">${t.water} / ${pr.waterGoal} ml · ${Math.round(t.water/pr.glass)} glasses</div>
        </div>
      </div>
      <div class="water-btns">
        <button class="chip water" data-water="${pr.glass}">＋ Glass (${pr.glass}ml)</button>
        <button class="chip water" data-water="500">＋ 500ml</button>
        <button class="chip water" data-water="1000">＋ 1L</button>
        <button class="chip minus" data-water="-${pr.glass}">－</button>
      </div>
    </div>

    ${MEALS.map(m=>mealGroup(m,t)).join("")}
  </div>`;
}
function mealGroup(m,t){
  const items=t.meals.filter(x=>x.meal===m.k);
  const cals=items.reduce((a,b)=>a+b.cal,0);
  return `<div class="card meal-group">
    <div class="meal-head"><div class="t"><span class="em">${m.e}</span>${m.l}</div>
      <div style="display:flex;gap:12px;align-items:center"><span class="cal">${round(cals)} kcal</span>
      <button class="meal-add" data-add="${m.k}">＋ Add</button></div></div>
    ${items.length?items.map((x,i)=>`<div class="food-item">
        <div class="fi-name">${x.name}<small>${x.qtyLabel||""}</small></div>
        <div class="fi-cal">${round(x.cal)}</div>
        <button class="del" data-del="${x.id}" aria-label="Remove">✕</button>
      </div>`).join(""):`<div class="empty">Nothing logged yet — tap Add</div>`}
  </div>`;
}

/* ---------- HABITS ---------- */
function viewHabits(){
  const rec=day();
  return header("Habits")+
  `<div class="card"><h2>Daily Habits <button data-act="add-habit">＋ New</button></h2>
    ${S.habits.length?S.habits.map(h=>habitRow(h,rec)).join(""):`<div class="empty">No habits yet. Add one to start a streak.</div>`}
  </div>
  <div class="card"><h2>This Week</h2>${weekHabitStrip()}</div>`;
}
function habitRow(h,rec){
  const st=streak(h.id); const val=(rec.habits&&rec.habits[h.id])||0;
  const done=isHabitDone(h,rec);
  const ctrl = h.type==="count"
    ? `<div class="counter"><button data-hminus="${h.id}">－</button>
        <span class="cval num" style="font-size:15px">${val}<small>/${h.target}</small></span>
        <button data-hplus="${h.id}">＋</button></div>`
    : `<button class="check ${done?'on':''}" data-hcheck="${h.id}">${done?'✓':''}</button>`;
  return `<div class="habit">
    <div class="h-em">${h.e}</div>
    <div class="h-body"><div class="h-name">${h.name}</div>
      <div class="h-streak ${st>0?'live':''}">${st>0?`🔥 ${st} day${st>1?'s':''} streak`:'Start today'}
        <button data-hdel="${h.id}" style="margin-left:8px;color:var(--ink-3);font-size:12px">edit</button></div></div>
    ${ctrl}
  </div>`;
}
function weekHabitStrip(){
  const days=[]; const now=new Date();
  for(let i=6;i>=0;i--){ const d=new Date(now.getTime()-i*86400000); days.push(d); }
  const total=S.habits.length||1;
  return `<div class="weekbars">${days.map(d=>{
    const ds=d.toLocaleDateString("en-CA"); const rec=S.days[ds];
    const done=S.habits.filter(h=>isHabitDone(h,rec)).length;
    const pct=Math.round(done/total*100);
    const isT=ds===todayStr();
    return `<div class="wk ${isT?'today':''}"><div class="bar" title="${done}/${total}">
      <div class="cap" style="--h:${pct}%;height:${pct}%"></div></div>
      <div class="d">${d.toLocaleDateString("en-US",{weekday:"narrow"})}</div></div>`;
  }).join("")}</div>`;
}

/* ---------- FOODS ---------- */
let foodQuery="", foodCat="All";
function viewFoods(){
  const cats=["All",...new Set(FOODS.map(f=>f.cat))];
  const list=allFoods().filter(f=>{
    const okC=foodCat==="All"||f.cat===foodCat;
    const okQ=!foodQuery||f.n.toLowerCase().includes(foodQuery.toLowerCase());
    return okC&&okQ;
  });
  // group by cat
  const groups={};
  list.forEach(f=>{ (groups[f.cat]=groups[f.cat]||[]).push(f); });
  return header("Foods")+
  `<div class="search"><span class="ic">🔍</span><input id="foodSearch" placeholder="Search ${allFoods().length} foods…" value="${foodQuery.replace(/"/g,'&quot;')}"></div>
  <div class="cats">${cats.map(c=>`<button class="cat ${c===foodCat?'on':''}" data-cat="${c}">${c}</button>`).join("")}</div>
  <div class="card" style="padding:12px 16px">
    ${list.length?Object.keys(groups).map(cat=>`
      <div class="cat-h">${cat}</div>
      ${groups[cat].map(f=>foodListItem(f)).join("")}
    `).join(""):`<div class="empty">No match. Try “Add custom food” below.</div>`}
    <div class="addfood-link" data-act="add-food">＋ Add a custom food</div>
  </div>`;
}
function foodListItem(f){
  const idx=allFoods().indexOf(f);
  return `<div class="food-item" data-food="${idx}">
    <div style="font-size:22px">${f.e||"🍽️"}</div>
    <div class="fi-name">${f.n}<small>${f.s} · ${f.cal} kcal · P${f.p} C${f.c} F${f.f}</small></div>
    <span class="add-ic">＋</span></div>`;
}

/* ---------- YOU ---------- */
function viewYou(){
  const p=S.profile;
  // week calorie bars
  const now=new Date(); const bars=[];
  for(let i=6;i>=0;i--){ const d=new Date(now.getTime()-i*86400000); const ds=d.toLocaleDateString("en-CA");
    const rec=S.days[ds]; const cal=rec?sumMeals(rec.meals).cal:0; bars.push({d,cal,ds}); }
  const maxCal=Math.max(p.calGoal,...bars.map(b=>b.cal),1);
  return header("You")+
  `<div class="card"><h2>This Week · Calories</h2>
    <div class="weekbars">${bars.map(b=>{
      const pct=Math.round(b.cal/maxCal*100); const isT=b.ds===todayStr();
      const over=b.cal>p.calGoal;
      return `<div class="wk ${isT?'today':''}"><div class="bar" title="${round(b.cal)} kcal">
        <div class="cap" style="height:${pct}%;background:${over?'var(--danger)':'var(--brand)'}"></div></div>
        <div class="d">${b.d.toLocaleDateString("en-US",{weekday:"narrow"})}</div></div>`;
    }).join("")}</div>
    <div style="text-align:center;margin-top:10px;font-size:12.5px;color:var(--ink-3);font-weight:600">Goal line: ${p.calGoal} kcal/day</div>
  </div>

  <div class="card"><h2>Daily Goals</h2>
    <div class="field"><label>Calorie target</label><div class="inrow"><input id="g-cal" type="number" inputmode="numeric" value="${p.calGoal}"><span class="unit">kcal</span></div></div>
    <div class="grid2">
      <div class="field"><label>Protein</label><div class="inrow"><input id="g-p" type="number" value="${p.p}"><span class="unit">g</span></div></div>
      <div class="field"><label>Carbs</label><div class="inrow"><input id="g-c" type="number" value="${p.c}"><span class="unit">g</span></div></div>
      <div class="field"><label>Fat</label><div class="inrow"><input id="g-f" type="number" value="${p.f}"><span class="unit">g</span></div></div>
      <div class="field"><label>Fiber</label><div class="inrow"><input id="g-fib" type="number" value="${p.fib}"><span class="unit">g</span></div></div>
    </div>
    <div class="grid2">
      <div class="field"><label>Water goal</label><div class="inrow"><input id="g-water" type="number" value="${p.waterGoal}"><span class="unit">ml</span></div></div>
      <div class="field"><label>Glass size</label><div class="inrow"><input id="g-glass" type="number" value="${p.glass}"><span class="unit">ml</span></div></div>
    </div>
    <button class="btn" data-act="save-goals">Save goals</button>
    <div style="height:8px"></div>
    <button class="btn ghost" data-act="automacro">Auto-set macros from calories</button>
  </div>

  <div class="card"><h2>Data</h2>
    <button class="btn ghost" data-act="export">Export my data (backup)</button>
    <div style="height:8px"></div>
    <button class="btn ghost" data-act="import">Import backup</button>
    <div style="height:8px"></div>
    <button class="btn danger" data-act="reset">Reset everything</button>
    <div style="text-align:center;font-size:12px;color:var(--ink-3);margin-top:10px">Data is stored only on this device.</div>
  </div>`;
}

/* ============================ SHEET ============================ */
const scrim=$("#scrim"), sheet=$("#sheet");
function openSheet(title,html){ $("#sh-title").textContent=title; $("#sh-body").innerHTML=html; scrim.classList.add("on"); sheet.classList.add("on"); }
function closeSheet(){ scrim.classList.remove("on"); sheet.classList.remove("on"); }
scrim.onclick=closeSheet; $("#sh-x").onclick=closeSheet;

// -- log food flow --
let pending=null; // {food, meal, mult}
function openFoodPicker(meal){
  const html=`
    <div class="search" style="margin-top:0"><span class="ic">🔍</span><input id="pickSearch" placeholder="Search foods…" autofocus></div>
    <div id="pickList" class="flist"></div>`;
  openSheet("Add to "+MEALS.find(m=>m.k===meal).l, html);
  const inp=$("#pickSearch"); renderPickList("",meal);
  inp.oninput=()=>renderPickList(inp.value,meal);
  setTimeout(()=>inp.focus(),300);
}
function renderPickList(q,meal){
  const list=allFoods().filter(f=>!q||f.n.toLowerCase().includes(q.toLowerCase())).slice(0,60);
  $("#pickList").innerHTML=list.map(f=>{
    const idx=allFoods().indexOf(f);
    return `<div class="food-item" data-pick="${idx}" data-meal="${meal}" style="cursor:pointer">
      <div style="font-size:22px">${f.e||"🍽️"}</div>
      <div class="fi-name">${f.n}<small>${f.s} · ${f.cal} kcal</small></div>
      <span class="add-ic">＋</span></div>`;
  }).join("")+`<div class="addfood-link" data-act="add-food">＋ Add a custom food</div>`;
}
function openQty(food,meal){
  pending={food,meal:meal||"snack",mult:1};
  drawQty();
}
function drawQty(){
  const f=pending.food, m=pending.mult;
  const calc=k=>round(f[k]*m);
  const html=`
    <div class="qty-food"><span class="qf-em">${f.e||"🍽️"}</span>
      <div><div class="qf-n">${f.n}</div><div class="qf-s">${f.s}</div></div></div>
    <label style="font-size:12px;font-weight:700;color:var(--ink-2);text-transform:uppercase;letter-spacing:.04em">Quantity</label>
    <div class="seg" id="qseg">
      ${[0.5,1,1.5,2,3].map(x=>`<button data-mult="${x}" class="${x===m?'on':''}">${x}×</button>`).join("")}
    </div>
    <div class="field"><label>Or exact servings</label><div class="inrow"><input id="qexact" type="number" step="0.25" min="0" value="${m}"><span class="unit">× ${f.s}</span></div></div>
    <label style="font-size:12px;font-weight:700;color:var(--ink-2);text-transform:uppercase;letter-spacing:.04em">Meal</label>
    <div class="meal-pick" id="mpick">
      ${MEALS.map(mm=>`<button data-mp="${mm.k}" class="${mm.k===pending.meal?'on':''}"><span class="em">${mm.e}</span>${mm.l}</button>`).join("")}
    </div>
    <div class="nutri-prev">
      <div><div class="v num" style="color:var(--ink)">${calc('cal')}</div><div class="k">kcal</div></div>
      <div><div class="v num" style="color:var(--p)">${calc('p')}</div><div class="k">Protein</div></div>
      <div><div class="v num" style="color:var(--c)">${calc('c')}</div><div class="k">Carbs</div></div>
      <div><div class="v num" style="color:var(--f)">${calc('f')}</div><div class="k">Fat</div></div>
      <div><div class="v num" style="color:var(--fib)">${calc('fib')}</div><div class="k">Fiber</div></div>
    </div>
    <button class="btn" data-act="confirm-log">Add ${calc('cal')} kcal</button>`;
  openSheet("Log food",html);
}
function commitLog(){
  const f=pending.food, m=pending.mult;
  const item={id:"m"+Date.now()+Math.random().toString(36).slice(2,6),name:f.n,meal:pending.meal,
    cal:f.cal*m,p:f.p*m,c:f.c*m,f:f.f*m,fib:f.fib*m,
    qtyLabel:(m===1?f.s:`${m}× ${f.s}`)};
  day().meals.push(item); save(); closeSheet();
  render(); toast(`Logged ${round(f.cal*m)} kcal ✓`);
}
// -- add custom food --
function openAddFood(){
  const html=`
    <div class="field"><label>Food name</label><div class="inrow"><input id="cf-n" placeholder="e.g. Mom's dal"></div></div>
    <div class="field"><label>Serving description</label><div class="inrow"><input id="cf-s" placeholder="e.g. 1 bowl (200g)"></div></div>
    <div class="grid2">
      <div class="field"><label>Calories</label><div class="inrow"><input id="cf-cal" type="number" inputmode="numeric"><span class="unit">kcal</span></div></div>
      <div class="field"><label>Protein</label><div class="inrow"><input id="cf-p" type="number"><span class="unit">g</span></div></div>
      <div class="field"><label>Carbs</label><div class="inrow"><input id="cf-c" type="number"><span class="unit">g</span></div></div>
      <div class="field"><label>Fat</label><div class="inrow"><input id="cf-f" type="number"><span class="unit">g</span></div></div>
      <div class="field"><label>Fiber</label><div class="inrow"><input id="cf-fib" type="number"><span class="unit">g</span></div></div>
      <div class="field"><label>Emoji</label><div class="inrow"><input id="cf-e" placeholder="🍽️" maxlength="2"></div></div>
    </div>
    <button class="btn" data-act="save-food">Save food</button>`;
  openSheet("Add custom food",html);
}
function saveCustomFood(){
  const g=id=>$("#"+id).value.trim();
  const n=g("cf-n"); if(!n){ toast("Give it a name"); return; }
  const num=id=>Math.max(0,parseFloat($("#"+id).value)||0);
  const food={n,e:g("cf-e")||"🍽️",s:g("cf-s")||"1 serving",cal:num("cf-cal"),p:num("cf-p"),c:num("cf-c"),f:num("cf-f"),fib:num("cf-fib"),cat:"My Foods",custom:true};
  S.customFoods.unshift(food); save(); closeSheet();
  if(TAB==="foods") render();
  toast("Food added ✓");
  // offer to log immediately
  setTimeout(()=>openQty(food,"snack"),350);
}
// -- add habit --
function openAddHabit(existing){
  const h=existing||{name:"",e:"⭐",type:"check",target:1};
  const html=`
    <div class="field"><label>Habit name</label><div class="inrow"><input id="hb-n" value="${h.name}" placeholder="e.g. Read 20 min"></div></div>
    <div class="field"><label>Emoji</label><div class="inrow"><input id="hb-e" value="${h.e}" maxlength="2" placeholder="⭐"></div></div>
    <div class="field"><label>Type</label>
      <div class="seg" id="hb-type">
        <button data-t="check" class="${h.type==='check'?'on':''}">✓ Yes / No</button>
        <button data-t="count" class="${h.type==='count'?'on':''}">🔢 Count</button>
      </div></div>
    <div class="field" id="hb-target-wrap" style="display:${h.type==='count'?'block':'none'}">
      <label>Daily target</label><div class="inrow"><input id="hb-target" type="number" value="${h.target||1}"><span class="unit">times</span></div></div>
    <button class="btn" data-act="save-habit" data-edit="${existing?existing.id:''}">${existing?'Update':'Add'} habit</button>
    ${existing?`<div style="height:8px"></div><button class="btn danger" data-act="del-habit" data-id="${existing.id}">Delete habit</button>`:''}`;
  openSheet(existing?"Edit habit":"New habit",html);
  let type=h.type;
  $("#hb-type").onclick=e=>{const b=e.target.closest("[data-t]");if(!b)return;type=b.dataset.t;
    $("#hb-type").querySelectorAll("button").forEach(x=>x.classList.toggle("on",x===b));
    $("#hb-target-wrap").style.display=type==="count"?"block":"none";};
  $("#sh-body").dataset.type=type; // read at save
  $("#hb-type").addEventListener("click",()=>{$("#sh-body").dataset.type=type;});
}
function saveHabit(editId){
  const n=$("#hb-n").value.trim(); if(!n){toast("Name it first");return;}
  const type=$("#sh-body").dataset.type||"check";
  const e=$("#hb-e").value.trim()||"⭐";
  const target=Math.max(1,parseInt($("#hb-target")?.value)||1);
  if(editId){ const h=S.habits.find(x=>x.id===editId); Object.assign(h,{name:n,e,type,target}); }
  else S.habits.push({id:"h"+Date.now(),name:n,e,type,target});
  save(); closeSheet(); render(); toast(editId?"Updated ✓":"Habit added ✓");
}

/* ============================ INTERACTIONS ============================ */
function toast(msg){ const t=$("#toast"); t.textContent=msg; t.classList.add("on"); clearTimeout(t._t); t._t=setTimeout(()=>t.classList.remove("on"),1800); }
function celebrate(x,y){
  const emojis=["🎉","🔥","💚","⭐","✨"];
  for(let i=0;i<7;i++){ const s=document.createElement("div"); s.className="burst"; s.textContent=emojis[i%emojis.length];
    s.style.left=x+"px"; s.style.top=y+"px";
    s.style.setProperty("--dx",(Math.random()*160-80)+"px"); s.style.setProperty("--dy",(-60-Math.random()*90)+"px");
    document.body.appendChild(s); setTimeout(()=>s.remove(),1000); }
}

function bind(){
  const inp=$("#foodSearch");
  if(inp){ inp.oninput=()=>{ foodQuery=inp.value; const list=$("#view"); const c=list.scrollTop; render(); $("#view").scrollTop=c; setTimeout(()=>{const i=$("#foodSearch");if(i){i.focus();i.setSelectionRange(i.value.length,i.value.length);}},0); }; }
}

// global click delegation
document.addEventListener("click",e=>{
  const el=t=>e.target.closest(t);
  let n;
  // nav
  if((n=el("#nav button"))){ TAB=n.dataset.tab; foodQuery=""; render(); $("#view").scrollTop=0; return; }
  // theme
  if((n=el('[data-act="theme"]'))){ toggleTheme(); return; }
  // fab
  if(e.target.id==="fab"){ openFoodPicker("snack"); return; }
  // water
  if((n=el("[data-water]"))){ const t=day(); t.water=Math.max(0,t.water+parseInt(n.dataset.water)); save(); render();
    if(t.water>=S.profile.waterGoal){ const r=n.getBoundingClientRect(); celebrate(r.left+r.width/2,r.top); } return; }
  if((n=el('[data-act="water-goal"]'))){ openWaterGoal(); return; }
  // meal add
  if((n=el("[data-add]"))){ openFoodPicker(n.dataset.add); return; }
  // delete meal
  if((n=el("[data-del]"))){ const t=day(); t.meals=t.meals.filter(m=>m.id!==n.dataset.del); save(); render(); return; }
  // foods tab category
  if((n=el("[data-cat]"))){ foodCat=n.dataset.cat; render(); return; }
  // food list item (foods tab) -> qty
  if((n=el("[data-food]"))){ const f=allFoods()[+n.dataset.food]; openQty(f,"snack"); return; }
  // picker item -> qty
  if((n=el("[data-pick]"))){ const f=allFoods()[+n.dataset.pick]; openQty(f,n.dataset.meal); return; }
  // qty controls
  if((n=el("[data-mult]"))){ pending.mult=parseFloat(n.dataset.mult); drawQty(); return; }
  if((n=el("[data-mp]"))){ pending.meal=n.dataset.mp; drawQty(); return; }
  if((n=el('[data-act="confirm-log"]'))){ commitLog(); return; }
  // add food
  if((n=el('[data-act="add-food"]'))){ openAddFood(); return; }
  if((n=el('[data-act="save-food"]'))){ saveCustomFood(); return; }
  // habits
  if((n=el("[data-hcheck]"))){ const id=n.dataset.hcheck; const t=day(); const was=t.habits[id];
    t.habits[id]=was?0:1; save(); render();
    if(!was){ const r=n.getBoundingClientRect(); celebrate(r.left+r.width/2,r.top); } return; }
  if((n=el("[data-hplus]"))){ const id=n.dataset.hplus; const t=day(); t.habits[id]=(t.habits[id]||0)+1; save();
    const h=S.habits.find(x=>x.id===id); const before=(t.habits[id]-1)>=h.target; render();
    if(!before&&t.habits[id]>=h.target){ const r=n.getBoundingClientRect(); celebrate(r.left,r.top); } return; }
  if((n=el("[data-hminus]"))){ const id=n.dataset.hminus; const t=day(); t.habits[id]=Math.max(0,(t.habits[id]||0)-1); save(); render(); return; }
  if((n=el("[data-hdel]"))){ const h=S.habits.find(x=>x.id===n.dataset.hdel); openAddHabit(h); return; }
  if((n=el('[data-act="add-habit"]'))){ openAddHabit(); return; }
  if((n=el('[data-act="save-habit"]'))){ saveHabit(n.dataset.edit||null); return; }
  if((n=el('[data-act="del-habit"]'))){ S.habits=S.habits.filter(h=>h.id!==n.dataset.id); save(); closeSheet(); render(); toast("Habit removed"); return; }
  // goals
  if((n=el('[data-act="save-goals"]'))){ saveGoals(); return; }
  if((n=el('[data-act="automacro"]'))){ autoMacro(); return; }
  if((n=el('[data-act="save-water-goal"]'))){ saveWaterGoal(); return; }
  // data
  if((n=el('[data-act="export"]'))){ exportData(); return; }
  if((n=el('[data-act="import"]'))){ importData(); return; }
  if((n=el('[data-act="reset"]'))){ if(confirm("Erase all your data on this device? This cannot be undone.")){ localStorage.removeItem(KEY); S=loadState(); render(); toast("Reset done"); } return; }
});

function openWaterGoal(){
  const p=S.profile;
  openSheet("Water goal",`
    <div class="field"><label>Daily water goal</label><div class="inrow"><input id="wg" type="number" value="${p.waterGoal}"><span class="unit">ml</span></div></div>
    <div class="field"><label>Glass size (quick-add)</label><div class="inrow"><input id="wgs" type="number" value="${p.glass}"><span class="unit">ml</span></div></div>
    <button class="btn" data-act="save-water-goal">Save</button>`);
}
function saveWaterGoal(){ S.profile.waterGoal=Math.max(200,parseInt($("#wg").value)||2500); S.profile.glass=Math.max(50,parseInt($("#wgs").value)||250); save(); closeSheet(); render(); toast("Saved ✓"); }
function saveGoals(){
  const g=(id,d)=>Math.max(0,parseInt($("#"+id).value)||d);
  const p=S.profile;
  p.calGoal=g("g-cal",2000); p.p=g("g-p",120); p.c=g("g-c",220); p.f=g("g-f",60); p.fib=g("g-fib",30);
  p.waterGoal=g("g-water",2500); p.glass=g("g-glass",250);
  save(); toast("Goals saved ✓");
}
function autoMacro(){
  // balanced split: 30% protein, 45% carbs, 25% fat (4/4/9 kcal per g)
  const cal=Math.max(1,parseInt($("#g-cal").value)||S.profile.calGoal);
  $("#g-p").value=round(cal*0.30/4); $("#g-c").value=round(cal*0.45/4); $("#g-f").value=round(cal*0.25/9);
  $("#g-fib").value=round(cal/1000*14); // ~14g fiber per 1000 kcal
  toast("Macros filled — review & save");
}
function exportData(){
  // Copy backup to clipboard (paste into Import on another device). Downloads are
  // blocked in the artifact sandbox, so clipboard is the reliable path.
  const blob=JSON.stringify(S);
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(blob).then(
      ()=>toast("Backup copied — paste into Import"),
      ()=>showBackupText(blob));
  } else showBackupText(blob);
}
function showBackupText(blob){
  openSheet("Your backup",`
    <p style="font-size:13.5px;color:var(--ink-2);margin-bottom:10px">Copy everything below and paste it into <b>Import</b> on your other device.</p>
    <textarea readonly style="width:100%;height:200px;border:1px solid var(--line);border-radius:12px;padding:12px;background:var(--surface-2);color:var(--ink);font-size:12px;resize:none" onclick="this.select()">${blob.replace(/</g,'&lt;')}</textarea>`);
}
function importData(){
  const txt=prompt("Paste your backup JSON here:");
  if(!txt) return;
  try{ const obj=JSON.parse(txt); if(!obj.profile||!obj.days) throw 0; S=Object.assign(loadState(),obj); save(); render(); toast("Imported ✓"); }
  catch(e){ toast("Couldn't read that backup"); }
}

/* theme */
function toggleTheme(){
  const root=document.documentElement;
  let cur=root.getAttribute("data-theme");
  if(!cur){ cur=matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light"; }
  const next=cur==="dark"?"light":"dark";
  root.setAttribute("data-theme",next);
  try{ localStorage.setItem("nourish.theme",next); }catch(e){}
}
(function initTheme(){ try{ const t=localStorage.getItem("nourish.theme"); if(t) document.documentElement.setAttribute("data-theme",t); }catch(e){} })();

/* ============================ SELF-CHECK ============================ */
function devCheck(){
  const meals=[{cal:100,p:10,c:5,f:2,fib:1},{cal:250,p:5,c:30,f:8,fib:4}];
  const t=sumMeals(meals);
  console.assert(t.cal===350&&t.p===15&&t.c===35&&t.fib===5,"sumMeals broken",t);
  // streak: no data -> 0
  console.assert(streak("nope")===0,"streak of unknown habit should be 0");
  // clamp
  console.assert(clamp(5,0,1)===1&&clamp(-1,0,1)===0,"clamp broken");
}
devCheck();

/* ============================ GO ============================ */
render();
</script>
