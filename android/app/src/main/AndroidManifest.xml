<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- No permissions are requested: the app has nothing but a browser tab in
       it, and asking for anything would show up on the Play data form for no
       reason. INTERNET is contributed by the library. -->
  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:allowBackup="true"
      android:supportsRtl="true">

    <meta-data android:name="asset_statements" android:resource="@string/asset_statements"/>

    <activity android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
        android:label="@string/launcher_name"
        android:exported="true">
      <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL"
          android:value="@string/launch_url"/>
      <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
          android:resource="@color/app_bg"/>
      <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
          android:resource="@color/app_bg"/>
      <meta-data android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
          android:resource="@mipmap/ic_launcher_foreground"/>
      <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
          android:resource="@color/app_bg"/>

      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <!-- autoVerify is what makes Android fetch assetlinks.json. If that file
           is missing or its fingerprint is wrong, the app still opens but with
           a browser address bar across the top, the usual symptom of a
           half-finished TWA. -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https" android:host="prasangr.github.io"
              android:pathPrefix="/NourishMeBro1/"/>
      </intent-filter>
    </activity>

    <activity android:name="com.google.androidbrowserhelper.trusted.FocusActivity"/>
    <activity android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity"
        android:configChanges="orientation|screenSize|screenLayout"/>
    <service android:name="com.google.androidbrowserhelper.trusted.DelegationService"
        android:exported="true">
      <intent-filter>
        <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE"/>
        <category android:name="android.intent.category.DEFAULT"/>
      </intent-filter>
    </service>
  </application>
</manifest>
